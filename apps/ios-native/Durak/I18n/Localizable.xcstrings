    "Apple didn't share a name this time. Pick a display name for the table — you can change it later in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple didn't share a name this time. Pick a display name for the table — you can change it later in Settings."
