    "A 36-card deck (6–Ace). Each player is dealt 6 cards. The bottom card sets the trump suit. The holder of the lowest trump attacks first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 36-card deck (6–Ace). Each player is dealt 6 cards. The bottom card sets the trump suit. The holder of the lowest trump attacks first."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колода из 36 карт (от 6 до туза). Каждому раздают по 6 карт. Нижняя карта определяет козырь. Владелец младшего козыря ходит первым."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колода з 36 карт (від 6 до туза). Кожному роздають по 6 карт. Нижня карта визначає козир. Власник молодшого козиря ходить першим."
          }
        }
      }
    },
