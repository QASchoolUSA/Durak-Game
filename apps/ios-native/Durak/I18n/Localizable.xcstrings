    "Once the deck is empty, emptying your hand takes you out. Last player with cards is the Durak. If nobody holds cards, it is a draw." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once the deck is empty, emptying your hand takes you out. Last player with cards is the Durak. If nobody holds cards, it is a draw."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда колода пуста, опустошение руки выводит из игры. Последний с картами — Дурак. Если карт ни у кого нет — ничья."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли колода порожня, спорожнення руки виводить із гри. Останній із картами — Дурак. Якщо карт ні в кого немає — нічия."
          }
        }
      }
    },
