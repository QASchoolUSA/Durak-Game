        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не передал имя. Выберите имя для стола — позже можно изменить в Настройках."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не передав ім’я. Оберіть ім’я для столу — пізніше можна змінити в Налаштуваннях."
          }
        }
      }
    },
